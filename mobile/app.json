{
  "expo": {
    "name": "Абие",
    "slug": "hubdesk",
    "version": "3.0.0-rc.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#080a12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hubdesk.app"
    },
    "android": {
      "package": "com.hubdesk.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешить Абие использовать Face ID для разблокировки"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "01978e1c-a7f9-4f8a-a6e0-de464db2d673"
      }
    },
    "owner": "snakedrs-team"
  }
}
